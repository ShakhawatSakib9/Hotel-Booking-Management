        <mxCell id="node_8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;spacingRight=10;fillColor=#ffffff;strokeColor=#d79b00;" value="&lt;div style=&quot;text-align: center; font-weight: bold; background-color: #d79b00; color: white; padding: 6px; margin: -5px -10px 10px -10px; border-top-left-radius: 4px; border-top-right-radius: 4px; font-size: 12px;&quot;&gt;MODEL (Eloquent ORM)&lt;/div&gt;&#xa;&lt;ul style=&quot;margin: 0; padding-left: 15px; font-size: 11px; color: #333333; line-height: 1.4;&quot;&gt;&#xa;  &lt;li&gt;Handles database interactions&lt;/li&gt;&#xa;  &lt;li&gt;Retrieves/Stores data&lt;/li&gt;&#xa;  &lt;li&gt;Eloquent ORM&lt;/li&gt;&#xa;&lt;/ul&gt;" vertex="1">
