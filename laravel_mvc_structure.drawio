        <mxCell id="node_6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;spacingRight=10;fillColor=#ffffff;strokeColor=#1e3a5f;" value="&lt;div style=&quot;text-align: center; font-weight: bold; background-color: #1e3a5f; color: white; padding: 6px; margin: -5px -10px 10px -10px; border-top-left-radius: 4px; border-top-right-radius: 4px; font-size: 12px;&quot;&gt;CONTROLLER (Laravel Controller)&lt;/div&gt;&#xa;&lt;ul style=&quot;margin: 0; padding-left: 15px; font-size: 11px; color: #333333; line-height: 1.4;&quot;&gt;&#xa;  &lt;li&gt;Handles business logic&lt;/li&gt;&#xa;  &lt;li&gt;Processes HTTP request&lt;/li&gt;&#xa;  &lt;li&gt;Coordinates data flow&lt;/li&gt;&#xa;&lt;/ul&gt;" vertex="1">
